{
  "name": "grok-weixin-cli",
  "version": "0.2.0",
  "description": "Connect WeChat (Weixin iLink bot) to Grok — Cursor SDK, xAI API, or an optional bridge that wakes your existing Grok Bot",
  "license": "MIT",
  "type": "module",
  "author": "evanyangg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evanyangg/grok-weixin-cli.git"
  },
  "homepage": "https://github.com/evanyangg/grok-weixin-cli#readme",
  "bugs": {
    "url": "https://github.com/evanyangg/grok-weixin-cli/issues"
  },
  "keywords": ["wechat", "weixin", "grok", "xai", "cursor", "mcp", "chatbot"],
  "bin": {
    "grok-weixin": "cli.mjs"
  },
  "files": [
    "cli.mjs",
    "lib/",
    "docs/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "check": "find cli.mjs lib test -name '*.mjs' -print0 | xargs -0 -n1 node --check"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@cursor/sdk": "^1.4.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "0.12.0",
    "zod": "^4.6.7"
  }
}
